# ─── Supabase ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your project values.
# Never commit .env — it is listed in .gitignore.

# Your Supabase project URL (Settings → API → Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase publishable (anon) key (Settings → API → Project API keys → anon public)
# This key is safe to expose in browser code — RLS policies control what anonymous users see.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# ─── Migration runner (Kiro / CI) ──────────────────────────────────────────────
# Personal Access Token — used by `npm run migrate` to apply SQL migrations automatically.
# Generate at: https://supabase.com/dashboard/account/tokens
# NEVER commit this value. Keep it in .env only.
SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token_here

# Your Supabase project reference ID (the subdomain in your project URL)
SUPABASE_PROJECT_REF=your_project_ref_here
